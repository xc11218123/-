<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>小數分數互轉器</title>
  <style>
    body {
      font-family: "Noto Sans TC", sans-serif;
      background: linear-gradient(180deg, #f4f4f9 0%, #dfe6e9 100%);
      margin: 0;
      padding: 2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
    }

    h1 {
      color: #333;
      margin-bottom: 1rem;
    }

    .input-area {
      background: #fff;
      padding: 1.5rem;
      border-radius: 1rem;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      width: 90%;
      max-width: 500px;
      text-align: center;
    }

    input {
      padding: 0.5rem 1rem;
      font-size: 1.1rem;
      border: 2px solid #ccc;
      border-radius: 8px;
      width: 80%;
      margin-bottom: 1rem;
    }

    button {
      background-color: #4a90e2;
      color: white;
      border: none;
      padding: 0.6rem 1.2rem;
      border-radius: 8px;
      font-size: 1rem;
      margin: 0.3rem;
      cursor: pointer;
      transition: background 0.2s;
    }

    button:hover {
      background-color: #357abd;
    }

    canvas {
      margin-top: 1.5rem;
      background: #fff;
      border-radius: 1rem;
      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.1);
    }
  </style>
</head>
<body>
  <h1>小數分數互轉器</h1>
  <div class="input-area">
    <input id="userInput" type="text" placeholder="請輸入分數或小數，例如 -4/3 或 0.75" />
    <br />
    <button onclick="calculate()">計算</button>
    <button onclick="clearCanvas()">清除</button>
  </div>
  <canvas id="calcCanvas" width="600" height="400"></canvas>

  <script>
    const canvas = document.getElementById('calcCanvas');
    const ctx = canvas.getContext('2d');

    function clearCanvas() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    }

    function calculate() {
      clearCanvas();
      const input = document.getElementById('userInput').value.trim();
      if (!input) return;

      ctx.font = '18px Noto Sans TC';
      ctx.fillStyle = '#333';

      let lines = [];
      if (input.includes('/')) {
        // 分數 → 小數
        const [numStr, denStr] = input.split('/');
        const numerator = parseFloat(numStr);
        const denominator = parseFloat(denStr);
        if (isNaN(numerator) || isNaN(denominator) || denominator === 0) {
          lines.push('❌ 無效的分數輸入');
          renderLines(lines);
          return;
        }

        const result = numerator / denominator;
        const absResult = Math.abs(result);
        const intPart = Math.trunc(absResult);
        const decimalPart = absResult - intPart;

        lines.push(`我們一步一步來計算： ${numerator} ÷ ${denominator} = ${result.toFixed(10)}`);

        const decimalStr = result.toString();
        if (/3{3,}|6{3,}|9{3,}/.test(decimalStr)) {
          lines.push('這是一個無限循環小數（例如小數部分重複出現）。');
          let rounded = Math.round(result * 10) / 10;
          const secDigit = Math.floor((absResult * 100) % 10);
          lines.push('若取小數點後第一位四捨五入：');
          lines.push(`小數第二位是 ${secDigit} → ${secDigit >= 5 ? '進位' : '不進位'}`);
          lines.push(`所以結果是： ${rounded}`);
        } else {
          const rounded = Math.round(result * 10) / 10;
          const secDigit = Math.floor((absResult * 100) % 10);
          lines.push('若取小數點後第一位四捨五入：');
          lines.push(`小數第二位是 ${secDigit} → ${secDigit >= 5 ? '進位' : '不進位'}`);
          lines.push(`所以結果是： ${rounded}`);
        }

        renderLines(lines);
      } else if (!isNaN(parseFloat(input))) {
        // 小數 → 分數
        const num = parseFloat(input);
        const isNegative = num < 0;
        const absNum = Math.abs(num);
        const decimalPart = absNum.toString().split('.')[1];

        if (!decimalPart) {
          lines.push(`${num} 可以寫成 ${num}/1`);
          renderLines(lines);
          return;
        }

        const denominator = Math.pow(10, decimalPart.length);
        const numerator = absNum * denominator;

        const gcdVal = gcd(Math.round(numerator), denominator);
        const simpleNum = Math.round(numerator) / gcdVal;
        const simpleDen = denominator / gcdVal;

        const sign = isNegative ? '-' : '';
        lines.push(`我們一步一步來計算：`);
        lines.push(`${num} = (${absNum} × ${denominator}) ÷ ${denominator}`);
        lines.push(`= ${Math.round(numerator)}/${denominator}`);
        lines.push(`約分後得到：${sign}${simpleNum}/${simpleDen}`);

        renderLines(lines);
      } else {
        lines.push('❌ 無效的輸入，請輸入分數或小數');
        renderLines(lines);
      }
    }

    function renderLines(lines) {
      let y = 40;
      lines.forEach(line => {
        ctx.fillText(line, 30, y);
        y += 30;
      });
    }

    function gcd(a, b) {
      return b === 0 ? a : gcd(b, a % b);
    }
  </script>
</body>
</html>

